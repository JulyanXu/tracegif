* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.zip binary
# Preserve checksummed generated files and pinned upstream bytes across OSes.
examples/source/*.svg -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/cases/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/cases/README.md text eol=lf
# Generated HTML embeds the pinned vendor license formatting verbatim.
docs/cases/*/animation.html -whitespace
skills/tracegif/assets/vendor/** -text -whitespace
